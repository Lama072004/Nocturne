<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Streaming vom eigenen Server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Erkennen, ob WLAN oder mobile Daten aktiv sind (Qualität, Offline-Modus). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wiedergabe im Hintergrund: Media3 startet den Service als Foreground-Service
         vom Typ "mediaPlayback". Ab Android 14 müssen beide Rechte deklariert sein. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Downloads im Hintergrund laufen als Foreground-Service vom Typ "dataSync". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Abgebrochene Downloads nach einem Neustart des Handys fortsetzen. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Hält CPU/WLAN nur während der Wiedergabe wach (siehe WAKE_MODE_NETWORK). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Ab Android 13 nötig, damit die Medien-Benachrichtigung angezeigt werden darf. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      usesCleartextTraffic="true": Viele eigene Musik-Server laufen im Heimnetz
      ohne HTTPS (z. B. http://192.168.1.10:4533). Android blockiert solche
      Verbindungen sonst, und der Player könnte nichts abspielen. Für Server im
      Internet sollte man trotzdem HTTPS verwenden; die Anmeldeseite versucht
      es deshalb immer zuerst mit HTTPS.
    -->
    <application
        android:label="Nocturne"
        android:usesCleartextTraffic="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Kennzeichnet die App als Musik-App für "Musik-App wählen"-Dialoge
                 (z. B. in Wecker- oder Assistenten-Einstellungen). -->
            <intent-filter>
                <action android:name="android.intent.action.MUSIC_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_MUSIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Der Wiedergabe-Dienst. Die beiden intent-filter sind der Kern dafür, dass
          Android, Android Auto, Wear OS und Assistenten die App als Medien-App finden:
           - MediaLibraryService: neue Media3-Schnittstelle
           - MediaBrowserService: alte Schnittstelle, die Android Auto und ältere
             Systemteile weiterhin abfragen
          exported="true" ist nötig, damit diese Systemdienste sich verbinden dürfen.
          Wer sich tatsächlich verbinden darf, entscheidet
          PlaybackService.LibraryCallback.onConnect (Allowlist).
        -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
          Download-Dienst. Nicht exportiert: Nur die App selbst darf Downloads
          starten. Der intent-filter erlaubt Media3, den Dienst neu zu starten,
          wenn z. B. wieder WLAN da ist.
        -->
        <service
            android:name=".MusicDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!--
          Cover-Bilder für die MediaSession (content://<applicationId>.artwork/<coverId>).
          Ersetzt die Server-URL im MediaItem, die Token und Salt enthielt.
          exported="true" ohne Berechtigung: Android Auto, Wear OS und die
          System-Oberfläche laden das Cover selbst und bekommen von uns keine
          URI-Freigabe. Unkritisch, weil der Provider nur lesend ist und nur
          Bilddaten herausgibt, nie Adressen oder Anmeldedaten (siehe
          ArtworkProvider.kt). grantUriPermissions ist deshalb nicht nötig.
        -->
        <provider
            android:name=".ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!--
          Media3-Empfänger für Medientasten (Bluetooth, Kabel-Fernbedienung)
          bei BEENDETEM Dienst. Er startet den PlaybackService und löst dort
          "Weiterspielen" aus (onPlaybackResumption). Ohne diesen Eintrag
          bietet Media3 der Systemoberfläche auch keine Medienkarte zum
          Fortsetzen nach einem Neustart an. exported="true": Das System
          stellt die Tasten-Broadcasts von außen zu.
        -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
          Knöpfe der Homescreen-Widgets. Nicht exportiert: Nur unsere eigenen
          PendingIntents erreichen ihn (siehe WidgetActionReceiver.kt).
        -->
        <receiver
            android:name=".WidgetActionReceiver"
            android:exported="false" />

        <!--
          Homescreen-Widgets (siehe HomeWidgets.kt). exported="false" ist hier
          richtig: APPWIDGET_UPDATE schickt das System, das auch nicht
          exportierte Empfänger erreicht.
        -->
        <receiver
            android:name=".SmallPlayerWidget"
            android:exported="false"
            android:label="@string/widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small_info" />
        </receiver>
        <receiver
            android:name=".MediumPlayerWidget"
            android:exported="false"
            android:label="@string/widget_medium_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_medium_info" />
        </receiver>
        <receiver
            android:name=".LargePlayerWidget"
            android:exported="false"
            android:label="@string/widget_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large_info" />
        </receiver>
        <receiver
            android:name=".QuickAccessWidget"
            android:exported="false"
            android:label="@string/widget_quick_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_info" />
        </receiver>

        <!-- Android Auto: siehe res/xml/automotive_app_desc.xml -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
