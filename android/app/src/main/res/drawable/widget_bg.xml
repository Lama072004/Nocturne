<?xml version="1.0" encoding="utf-8"?>
<!-- Hintergrund aller Widgets: dunkel mit runden Ecken. Der Radius kommt ab
     Android 12 vom System (values-v31/dimens.xml), damit die Widgets zu den
     übrigen auf dem Homescreen passen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF1C1B22" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
