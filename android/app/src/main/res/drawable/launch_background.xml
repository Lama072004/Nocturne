<?xml version="1.0" encoding="utf-8"?>
<!--
  Startbild, das Android zeigt, bis Flutter das erste Bild gezeichnet hat.
  Gleiche Farbe und gleiches Logo wie das App-Icon: So gibt es beim Start
  keinen weissen Blitz, was im Dunkeln (und auf OLED) stoerend waere.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
